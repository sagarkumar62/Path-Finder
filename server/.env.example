PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string for production deployment
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/career_pathfinder?retryWrites=true&w=majority

# JWT Secrets (Use strong random strings in Render environment)
JWT_ACCESS_SECRET=your_production_jwt_access_secret_key
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_key

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# URL of deployed Frontend on Render (or localhost:3000 for local dev)
FRONTEND_URL=https://<your-frontend-app>.onrender.com

# Optional AI Service config or Gemini direct API key
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000
AI_MOCK_MODE=false
GEMINI_API_KEY=your_gemini_api_key_here
